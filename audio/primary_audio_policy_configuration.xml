<?xml version="1.0" encoding="UTF-8"?>
<!-- SpacemiT K3 Pico-ITX Primary Audio HAL Module Configuration

     Playback goes to the USB-C DisplayPort (ALSA card "K3DP1Audio"), capture to
     the on-board ES8326 ("sndes8326"). The HAL picks the ALSA card per device
     port from the CARD_<n>_DEV_<m> address (StreamPrimary::getCardAndDeviceId),
     falling back to ro.vendor.audio.primary.card_name otherwise.

     The DP output is declared AUDIO_DEVICE_OUT_SPEAKER on purpose, not
     AUDIO_DEVICE_OUT_HDMI: the HAL asserts that an attached device has no
     connection type, and HDMI has one, so listing an HDMI device under
     <attachedDevices> aborts convertModuleConfigToAidl and puts audioserver in
     a crash loop that never lets boot reach the UI. -->
<module name="primary" halVersion="3.0">
    <attachedDevices>
        <item>Speaker</item>
        <item>Built-In Mic</item>
    </attachedDevices>
    <defaultOutputDevice>Speaker</defaultOutputDevice>

    <mixPorts>
        <mixPort name="primary output" role="source" flags="AUDIO_OUTPUT_FLAG_PRIMARY">
            <profile name="" format="AUDIO_FORMAT_PCM_16_BIT"
                     samplingRates="48000"
                     channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
        </mixPort>

        <mixPort name="primary input" role="sink">
            <profile name="" format="AUDIO_FORMAT_PCM_16_BIT"
                     samplingRates="48000"
                     channelMasks="AUDIO_CHANNEL_IN_STEREO"/>
        </mixPort>
    </mixPorts>

    <devicePorts>
        <devicePort tagName="Speaker" role="sink" type="AUDIO_DEVICE_OUT_SPEAKER" address="CARD_2_DEV_0">
            <profile name="" format="AUDIO_FORMAT_PCM_16_BIT"
                     samplingRates="48000"
                     channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
        </devicePort>

        <devicePort tagName="Built-In Mic" type="AUDIO_DEVICE_IN_BUILTIN_MIC" role="source" address="CARD_1_DEV_0">
            <profile name="" format="AUDIO_FORMAT_PCM_16_BIT"
                     samplingRates="48000"
                     channelMasks="AUDIO_CHANNEL_IN_STEREO"/>
        </devicePort>
    </devicePorts>

    <routes>
        <route type="mix" sink="Speaker"
               sources="primary output"/>
        <route type="mix" sink="primary input"
               sources="Built-In Mic"/>
    </routes>
</module>
